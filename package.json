{
  "name": "finance-tracker",
  "private": true,
  "version": "1.0.1-beta",
  "description": "A local finance tracker for income, expenses, budgets, and subscriptions",
  "author": "Finance Tracker",
  "main": "desktop/main.mjs",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/migrate.ts",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "desktop:rebuild": "electron-builder install-app-deps",
    "desktop:start": "npm run build && npm run desktop:rebuild && electron .",
    "desktop:build": "npm run build && electron-builder --publish never",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:smoke": "electron . --smoke-test",
    "desktop:test": "node desktop/test.mjs",
    "web:rebuild": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tanstack/react-table": "^9.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.65.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.3"
  }
}
